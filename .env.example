# ═══════════════════════════════════════════════════════════════
# BIMS - Barangay Information Management System
# Environment Configuration
# ═══════════════════════════════════════════════════════════════

APP_NAME="BIMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════════
# DATABASE (Neon PostgreSQL)
# ═══════════════════════════════════════════════════════════════
# Option 1: Paste your Neon connection URL directly (Recommended)
# DB_URL=postgresql://neondb_owner:xxxx@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option 2: Individual fields (from your Neon dashboard)
DB_CONNECTION=pgsql
DB_HOST=ep-xxx-us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════════
# FILE STORAGE (Cloudflare R2 or any S3-compatible service)
# ═══════════════════════════════════════════════════════════════
# Required for file uploads on Vercel (local disk is read-only)
# Cloudflare R2 (free tier): https://dash.cloudflare.com
# AWS S3: https://console.aws.amazon.com/s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
